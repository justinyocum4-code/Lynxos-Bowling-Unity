<?xml version="1.0" encoding="utf-8"?>
<!-- Lynxos Bowling — custom manifest. Unity merges this with its generated
     manifest. The LEANBACK_LAUNCHER entry is what makes the game show up
     in the Google TV apps list; without it the TV launcher hides the app
     entirely. leanback is required=false so the same APK still installs
     on phones and tablets. No android:banner: Unity 6000 removed raw
     res/ resources under Assets/Plugins/Android/, so a banner would need
     an AAR — dropped for v1.1.1, the game lists with a default banner. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.software.leanback" android:required="false" />
  <application>
    <activity android:name="com.unity3d.player.UnityPlayerActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
